# === Coding-agent credentials (EXAMPLE) ===
#
# Do NOT edit this file. Your Dayta contact will send you a real file named ".env"
# (no ".example" on the end) plus a key file. Drop both into this same folder and
# you're done. This .example just shows the shape of what you'll receive.
#
# The .env and the key file are secrets. Never email them around, never commit them
# to git, never paste them into a chat. .gitignore already keeps them out of git.

# Path to the Google service-account key file your Dayta contact created for you
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Your BigQuery project and datasets
GCP_PROJECT_ID=your-bigquery-project
BQ_DATASET=your_main_dataset
# A private sandbox the agent can write to for advanced analysis (read-only everywhere else)
BQ_SCRATCH_DATASET=your_scratch_dataset
